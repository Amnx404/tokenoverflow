NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional until the least-privilege runtime role is provisioned. Use the shared
# transaction pooler URI from Supabase Connect, with the application role.
# No postgres/admin/service_role login. Never expose this variable to the browser.
DATABASE_URL=

# Canonical auth callback origin. Production defaults to https://tokenoverflow.app.
# Local testing defaults to http://localhost:3000; use the same browser origin.
AUTH_SITE_URL=

# Optional manual observability. Default off; existing PostHog project only.
# Project capture token stays server-only. Never use a personal/admin API key.
POSTHOG_PROJECT_TOKEN=
# Exactly https://us.i.posthog.com or https://eu.i.posthog.com for the project.
POSTHOG_HOST=
TOKENOVERFLOW_TELEMETRY_ENABLED=false
# Boolean only, exposed at build time; no token or host enters the browser.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
# Optional commit SHA; Vercel defaults to VERCEL_GIT_COMMIT_SHA.
TOKENOVERFLOW_RELEASE=
# Controlled QA may force synthetic classification; never overrides identity.
TOKENOVERFLOW_TELEMETRY_SYNTHETIC=false
