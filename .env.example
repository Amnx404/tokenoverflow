NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional until the least-privilege runtime role is provisioned. Use the shared
# transaction pooler URI from Supabase Connect, with the application role.
# No postgres/admin/service_role login. Never expose this variable to the browser.
DATABASE_URL=

# Canonical auth callback origin. Production defaults to https://tokenoverflow.app.
# Local testing defaults to http://localhost:3000; use the same browser origin.
AUTH_SITE_URL=
